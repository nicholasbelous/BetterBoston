# Copy this file to .env (same folder) and fill in what you need.

# Optional: lets Claude write the action plan. Without it, a rule-based plan is used.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Uses the free US Census geocoder for real addresses. Set to false to work fully offline.
USE_CENSUS_GEOCODER=true

# Where the frontend runs (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
