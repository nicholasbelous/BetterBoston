{
  "name": "climatecheck-ma",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:frontend": "next dev -p 5174",
    "build": "next build",
    "start": "next start",
    "start:frontend": "next start -p 5174",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run validate:data && npm run build",
    "sample:data": "python3 pipeline/make_sample_data.py",
    "validate:data": "python3 pipeline/validate_scores.py",
    "check:programs": "node scripts/check-programs.mjs",
    "build:climate": "node scripts/build-climate-context.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
