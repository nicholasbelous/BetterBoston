# Copy to .env.local and fill in. Never commit real values.
# Everything without NEXT_PUBLIC_ is server-only.

# ---------- Claude (Anthropic API) ----------
# Create a key at https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
# Haiku is fast and cheap, which is plenty for short action plans.
CLAUDE_MODEL=claude-haiku-5-5

# ---------- Geocoder ----------
# census = US Census Bureau geocoder (free, no key, US street addresses)
# nominatim = OpenStreetMap Nominatim (free, max 1 request/second, needs a real User-Agent)
GEOCODER_PROVIDER=census
GEOCODER_USER_AGENT=BetterBoston/0.1 (hackathon demo; contact: you@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ---------- Map basemap ----------
# Map tiles load in the browser, so this one is public (NEXT_PUBLIC_).
# Default: MassGIS 2025 aerial imagery (spring 2025, leaf-off) on ArcGIS Online.
NEXT_PUBLIC_BASEMAP_TILE_URL=https://tiles.arcgis.com/tiles/hGdibHYSPO59RG1h/arcgis/rest/services/Massachusetts_Aerial_Imagery_2025/MapServer/tile/{z}/{y}/{x}
NEXT_PUBLIC_BASEMAP_ATTRIBUTION=Imagery: MassGIS 2025 Aerial Imagery

# ---------- Programs ----------
# Programs with last_verified = null are hidden from users and the AI.
# Set true ONLY for local development before the program data is verified.
ALLOW_UNVERIFIED_PROGRAMS=false

# ---------- Live data ----------
# Weather (NWS + Open-Meteo), air quality, flood maps, street trees, places, and
# census tract data. All free, no keys. Set false for a fully offline demo.
LIVE_DATA_ENABLED=true

# ---------- Scores ----------
# Folder with demo_grid.geojson + demo_grid.meta.json. Only change this for testing.
SCORES_DIR=data/scores

# ---------- Stretch: solar ----------
GOOGLE_SOLAR_API_KEY=
