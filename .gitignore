# ---------- Raw imagery and large rasters (never commit) ----------
pipeline/raw/*
!pipeline/raw/.gitkeep
pipeline/work/*
!pipeline/work/.gitkeep
*.tif
*.tiff
*.TIF
*.jp2
*.j2w
*.aux.xml
*.zip
*.tar
*.tar.gz
*.img
*.vrt
*.nc

# Only the small processed outputs in data/scores/ are committed.

